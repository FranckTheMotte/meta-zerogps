# short-description: Create Raspberry Pi SD card z-image 
# long-description: Creates a partitioned SD card image for use with
# Raspberry Pi Zero 2. Boot files are located in the first vfat partition.
# Creates a data partition to isolate custom data.

part /boot --source bootimg-partition --ondisk mmcblk0 --fstype=vfat --label boot --active --align 4 --size 64M
part / --source rootfs --ondisk mmcblk0 --fstype=ext4 --label rootfs --align 4
part /data --ondisk mmcblk0 --fstype=ext4 --label data --align 4 --size 512M --use-uuid --fsoptions="rw,noatime"
bootloader --append="rootwait"